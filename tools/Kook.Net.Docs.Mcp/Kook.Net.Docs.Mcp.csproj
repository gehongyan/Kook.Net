<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    独立文档 MCP 服务，不继承 props/common.props：
    那套属性面向可打包的多 TFM 类库（IsPackable、TreatWarningsAsErrors、
    net462/netstandard 等），对一个自托管的 ASP.NET Core 服务不适用。

    采用 Streamable HTTP 传输（ModelContextProtocol.AspNetCore），
    以便容器化部署，客户端通过网络连接 MCP 端点。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kook.Net.Docs.Mcp</RootNamespace>
    <AssemblyName>Kook.Net.Docs.Mcp</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>kook-net-docs-mcp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
