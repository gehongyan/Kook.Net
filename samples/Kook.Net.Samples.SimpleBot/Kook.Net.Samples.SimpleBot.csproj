<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../props/samples.props"/>

  <!-- Keep NativeAOT scoped to this executable, not the referenced legacy targets. -->
  <PropertyGroup Condition="'$(SimpleBotNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replace the umbrella reference imported by samples.props in every mode. -->
    <ProjectReference Remove="..\..\src\Kook.Net\Kook.Net.csproj" />
    <ProjectReference Include="..\..\src\Kook.Net.WebSocket\Kook.Net.WebSocket.csproj" />
    <ProjectReference Include="..\..\src\Kook.Net.Experimental\Kook.Net.Experimental.csproj" />
  </ItemGroup>

</Project>
